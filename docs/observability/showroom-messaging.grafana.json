{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping the OTel collector export.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["showroom", "messaging", "amqp"],
  "title": "ShowRoom — Messaging (AMQP request/reply)",
  "uid": "showroom-messaging",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "feature",
        "label": "Feature",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(showroom_messaging_roundtrip_duration_milliseconds_count, messaging_feature)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "type": "row",
      "title": "Round-trip (caller-perceived)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Round-trip latency (p50 / p95 / p99)",
      "description": "showroom.messaging.roundtrip.duration — produce → reply received, as perceived by the caller.",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(showroom_messaging_roundtrip_duration_milliseconds_bucket{messaging_feature=~\"$feature\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(showroom_messaging_roundtrip_duration_milliseconds_bucket{messaging_feature=~\"$feature\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(showroom_messaging_roundtrip_duration_milliseconds_bucket{messaging_feature=~\"$feature\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer handler latency (p50 / p95 / p99)",
      "description": "showroom.messaging.handler.duration — dequeue → reply produced, on the consumer.",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(showroom_messaging_handler_duration_milliseconds_bucket{messaging_feature=~\"$feature\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(showroom_messaging_handler_duration_milliseconds_bucket{messaging_feature=~\"$feature\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(showroom_messaging_handler_duration_milliseconds_bucket{messaging_feature=~\"$feature\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Transport latency ≈ round-trip − handler (p95)",
      "description": "Approximate pure broker + network + queue time: p95 round-trip minus p95 handler. Isolates the AMQP cost from business processing.",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(showroom_messaging_roundtrip_duration_milliseconds_bucket{messaging_feature=~\"$feature\"}[$__rate_interval]))) - histogram_quantile(0.95, sum by (le) (rate(showroom_messaging_handler_duration_milliseconds_bucket{messaging_feature=~\"$feature\"}[$__rate_interval])))",
          "legendFormat": "transport p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Throughput by outcome (req/s)",
      "description": "Round-trip rate split by outcome (success / failure / invalid_request).",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (messaging_outcome) (rate(showroom_messaging_roundtrip_duration_milliseconds_count{messaging_feature=~\"$feature\"}[$__rate_interval]))",
          "legendFormat": "{{messaging_outcome}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Round-trip p95 (now)",
      "datasource": "${datasource}",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(showroom_messaging_roundtrip_duration_milliseconds_bucket{messaging_feature=~\"$feature\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Failure ratio (non-success)",
      "description": "Share of round-trips ending in failure or invalid_request — degradations / unrecovered timeouts.",
      "datasource": "${datasource}",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(showroom_messaging_roundtrip_duration_milliseconds_count{messaging_feature=~\"$feature\", messaging_outcome!=\"success\"}[$__rate_interval])) / clamp_min(sum(rate(showroom_messaging_roundtrip_duration_milliseconds_count{messaging_feature=~\"$feature\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "failure ratio"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Round-trip p95 by feature",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, messaging_feature) (rate(showroom_messaging_roundtrip_duration_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "{{messaging_feature}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Retries (cold-start warm-up)",
      "description": "showroom.messaging.retries — retry attempts, typically the first message after startup while the broker/reply-queue warms up. A steady non-zero rate points to a genuine problem.",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (messaging_feature) (rate(showroom_messaging_retries_total{messaging_feature=~\"$feature\"}[$__rate_interval]))",
          "legendFormat": "{{messaging_feature}}"
        }
      ]
    }
  ]
}
