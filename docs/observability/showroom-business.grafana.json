{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping the OTel collector export.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["showroom", "business", "orders"],
  "title": "ShowRoom — Business (Orders)",
  "uid": "showroom-business-orders",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "currency",
        "label": "Currency",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(showroom_orders_created_total, order_currency)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "row",
      "title": "Orders",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Orders created (per minute)",
      "description": "showroom.orders.created — rate of created orders, split by currency.",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "opm" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (order_currency) (rate(showroom_orders_created_total{order_currency=~\"$currency\"}[$__rate_interval])) * 60",
          "legendFormat": "{{order_currency}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Average order value (montant moyen)",
      "description": "sum(rate(amount_sum)) / sum(rate(amount_count)) — the mean order total over the window, by currency.",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "currencyEUR" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (order_currency) (rate(showroom_orders_amount_sum{order_currency=~\"$currency\"}[$__rate_interval])) / clamp_min(sum by (order_currency) (rate(showroom_orders_amount_count{order_currency=~\"$currency\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{order_currency}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Order value distribution (p50 / p95)",
      "description": "showroom.orders.amount histogram — spread of order totals.",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "currencyEUR" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(showroom_orders_amount_bucket{order_currency=~\"$currency\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(showroom_orders_amount_bucket{order_currency=~\"$currency\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Orders created (range)",
      "description": "Total orders created over the selected time range.",
      "datasource": "${datasource}",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(showroom_orders_created_total{order_currency=~\"$currency\"}[$__range]))",
          "legendFormat": "orders"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Revenue booked (range)",
      "description": "Sum of created-order totals over the selected time range (per currency). Business KPI, not accounting truth.",
      "datasource": "${datasource}",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "currencyEUR" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (order_currency) (increase(showroom_orders_amount_sum{order_currency=~\"$currency\"}[$__range]))",
          "legendFormat": "{{order_currency}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Customers & funnel",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }
    },
    {
      "type": "timeseries",
      "title": "Customers registered (per minute)",
      "description": "showroom.customers.registered — customer acquisition rate.",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "opm" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(showroom_customers_registered_total[$__rate_interval])) * 60",
          "legendFormat": "registered"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Items per order (average & p95)",
      "description": "showroom.orders.items — basket size in line items. Average = sum/count.",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(showroom_orders_items_sum[$__rate_interval])) / clamp_min(sum(rate(showroom_orders_items_count[$__rate_interval])), 1e-9)",
          "legendFormat": "avg items"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(showroom_orders_items_bucket[$__rate_interval])))",
          "legendFormat": "p95 items"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Create rejections by reason (funnel quality)",
      "description": "showroom.<entity>.create.rejected — rejected create attempts across modules, split by reason (validation / domain / conflict). A rising rate = something upstream is sending bad or conflicting data.",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "cpm" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(showroom_orders_create_rejected_total[$__rate_interval])) * 60",
          "legendFormat": "order · {{reason}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(showroom_products_create_rejected_total[$__rate_interval])) * 60",
          "legendFormat": "product · {{reason}}"
        },
        {
          "refId": "C",
          "expr": "sum by (reason) (rate(showroom_customers_create_rejected_total[$__rate_interval])) * 60",
          "legendFormat": "customer · {{reason}}"
        }
      ]
    }
  ]
}
