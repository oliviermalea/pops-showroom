<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnableSdkContainerDebugging>True</EnableSdkContainerDebugging>
		<ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>
		<UserSecretsId>b1d3c2a4-5e6f-4708-9a1b-2c3d4e5f6071</UserSecretsId>
		<InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
		<PackageReference Include="Scalar.AspNetCore" />
		<PackageReference Include="WolverineFx.RabbitMQ" />
		<!-- Runtime (Roslyn) codegen — Wolverine 6.x no longer bundles it in the core package. -->
		<PackageReference Include="WolverineFx.RuntimeCompilation" />
		<PackageReference Include="Serilog" />
		<PackageReference Include="Serilog.AspNetCore" />
		<PackageReference Include="Serilog.Sinks.ApplicationInsights" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ContainerPort Include="8081" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\aspire\ShowRoom.ServiceDefaults\ShowRoom.ServiceDefaults.csproj" />
		<!-- Hosts the Customer module only. Order data is obtained over the message bus via the
		     Order.Contracts message contract (referenced transitively through the Customer module). -->
		<ProjectReference Include="..\..\modules\ShowRoom.Modules.Customer\ShowRoom.Modules.Customer.csproj" />
	</ItemGroup>

</Project>
