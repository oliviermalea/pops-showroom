{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Messaging": {
    "Enabled": true,
    "Transport": "RabbitMq",
    "RabbitMqConnectionName": "messaging",
    "UseTransactionalOutbox": true,
    "MessageStoreConnectionName": "showroom",
    "MessageStoreSchema": "wolverine"
  },
  "FeatureManagement": {
    "Customer": true
  }
}
