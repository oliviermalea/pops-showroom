<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>ShowRoom.Modules.Order</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="ShowRoom.Modules.Order.Tests" />
		<InternalsVisibleTo Include="ShowRoom.Modules.Order.IntegrationTests" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\buildingblocks\ShowRoom.BuildingBlocks\ShowRoom.BuildingBlocks.csproj" />
		<ProjectReference Include="..\..\sharedkernel\ShowRoom.SharedKernel\ShowRoom.SharedKernel.csproj" />
		<ProjectReference Include="..\ShowRoom.Modules.Order.Contracts\ShowRoom.Modules.Order.Contracts.csproj" />
		<!-- Consumes the Customer module's IntegrationEvent contract (CustomerRegistered) over the bus. -->
		<ProjectReference Include="..\ShowRoom.Modules.Customer.Contracts\ShowRoom.Modules.Customer.Contracts.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
		<PackageReference Include="Asp.Versioning.Http" />
		<PackageReference Include="Meziantou.Framework.StronglyTypedId" />
		<PackageReference Include="FluentValidation" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
		<PackageReference Include="Microsoft.OpenApi" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Analyzers" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Scrutor" />
		<!-- The message handler reads the standard MessageHeaders from the Wolverine Envelope. -->
		<PackageReference Include="WolverineFx" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Features\CreatePublicOrder\" />
	</ItemGroup>

</Project>
