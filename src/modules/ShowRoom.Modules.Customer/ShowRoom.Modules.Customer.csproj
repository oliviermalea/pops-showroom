<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>ShowRoom.Modules.Customer</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="ShowRoom.Modules.Customer.Tests" />
		<InternalsVisibleTo Include="ShowRoom.Modules.Customer.IntegrationTests" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\buildingblocks\ShowRoom.BuildingBlocks\ShowRoom.BuildingBlocks.csproj" />
		<ProjectReference Include="..\..\sharedkernel\ShowRoom.SharedKernel\ShowRoom.SharedKernel.csproj" />
		<!-- Cross-module access is allowed ONLY through the Order message contract (no impl/DB access). -->
		<ProjectReference Include="..\ShowRoom.Modules.Order.Contracts\ShowRoom.Modules.Order.Contracts.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
		<PackageReference Include="Asp.Versioning.Http" />
		<PackageReference Include="Meziantou.Framework.StronglyTypedId" />
		<PackageReference Include="FluentValidation" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
		<PackageReference Include="Microsoft.OpenApi" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Analyzers" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Scrutor" />
		<!-- Machine-to-machine messaging (AMQP request/reply) — never HTTP for cross-module calls. -->
		<PackageReference Include="WolverineFx" />
	</ItemGroup>

</Project>
