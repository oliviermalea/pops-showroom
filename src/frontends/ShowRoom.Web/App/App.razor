@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ShowRoom.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script type="module" src="@Assets["App/Layout/shell.js"]"></script>
</body>

</html>

@* Aucun `@rendermode` ici : les pages sont en **SSR statique** par défaut et déclarent
   `@rendermode InteractiveServer` individuellement lorsqu'elles ont besoin d'un circuit. *@
