@page "/customers"
@attribute [StreamRendering]
@* SSR statique + streaming : aucun circuit SignalR pour cet écran. La coquille et le squelette
   partent dès le premier octet, le tableau est diffusé quand l'API répond. Les interactions
   (filtre, pagination) passent par un formulaire GET et des liens — la navigation enrichie de
   blazor.web.js les rend sans rechargement complet. *@
@using ShowRoom.Web.Features.Customer
@inject ICustomerFacade CustomerFacade

<PageTitle>Clients — ShowRoom</PageTitle>

<section class="list" aria-labelledby="list-title">
    <div class="list__meta">
        <p class="section-label">Module Customer</p>
        <span class="module-tag">Liste</span>
    </div>

    <div class="list__body">
        <div class="list__header">
            <h1 class="list__title" id="list-title">Clients</h1>
            <a class="list__action" href="/customers/new">Créer un client</a>
        </div>

        @* Formulaire GET : la recherche devient une query string, donc une URL partageable.
           Omettre `page` ramène volontairement à la première page. *@
        <form class="filter" method="get" action="/customers" data-enhance>
            <label class="filter__label" for="customer-search">Rechercher par nom</label>

            <div class="filter__row">
                <input id="customer-search"
                       name="search"
                       class="filter__input"
                       type="search"
                       autocomplete="off"
                       placeholder="Nom ou prénom"
                       value="@Search" />

                <button type="submit" class="filter__submit">Filtrer</button>

                @if (!string.IsNullOrWhiteSpace(Search))
                {
                    <a class="filter__reset" href="/customers">Effacer</a>
                }
            </div>
        </form>

        <div class="list__content">
            @if (isLoading)
            {
                <CustomerTableSkeleton Rows="SkeletonRows" />
            }
            else if (result is null || result.Outcome == CustomerListOutcome.Unavailable)
            {
                <div class="list__state list__state--error list__panel" role="alert">
                    <p>Le service Customer est momentanément indisponible.</p>
                    <a class="list__retry" href="@PageUrl(CurrentPage)">Réessayer</a>
                </div>
            }
            else if (result.Page!.IsEmpty)
            {
                <p class="list__state list__state--muted list__panel">
                    @(string.IsNullOrWhiteSpace(Search)
                        ? "Aucun client enregistré pour le moment."
                        : $"Aucun client ne correspond à « {Search} ».")
                </p>
            }
            else
            {
                <div class="list__panel">
                    <CustomerTable Items="result.Page.Items" />
                </div>
            }

            @* Toujours rendue : masquée (sans perdre sa place) tant qu'il n'y a pas de page à
               parcourir, pour que l'arrivée des données ne décale jamais le tableau. *@
            <nav class="pager @(HasPage ? null : "pager--hidden")" aria-label="Pagination">
                <p class="pager__count" aria-live="polite">@CountLabel</p>

                <div class="pager__actions">
                    @if (CanGoPrevious)
                    {
                        <a class="pager__button" href="@PageUrl(CurrentPage - 1)" rel="prev">Précédent</a>
                    }
                    else
                    {
                        <span class="pager__button pager__button--disabled" aria-disabled="true">Précédent</span>
                    }

                    @if (CanGoNext)
                    {
                        <a class="pager__button" href="@PageUrl(CurrentPage + 1)" rel="next">Suivant</a>
                    }
                    else
                    {
                        <span class="pager__button pager__button--disabled" aria-disabled="true">Suivant</span>
                    }
                </div>
            </nav>
        </div>
    </div>
</section>

@code {
    private const int PageSize = 20;

    private const int SkeletonRows = 5;

    // Le squelette annonce « un tableau arrive », il ne cherche pas a egaler la hauteur finale :
    // le calquer sur PageSize alourdissait la reponse de 21,6 a 28,4 Ko, payes a CHAQUE requete (le
    // streaming interdit la compression) pour une fidelite qui ne sert que sur un chargement lent.
    // Il ne peut pas non plus memoriser la page precedente : en SSR statique chaque requete instancie
    // un composant neuf, un champ d'instance repartirait toujours de sa valeur par defaut.
    //
    // Aucune duree minimale d'affichage non plus : en SSR + streaming le squelette fait partie du
    // premier flush HTML et le navigateur coalesce les peintures, donc une reponse rapide ne le fait
    // pas clignoter. Le plancher de 350 ms qui existait ici retardait la reponse complete de 345 ms
    // pour rien (mesure : 381 ms avec, 83 ms sans). Le squelette n'apparait donc que si l'API est
    // reellement lente — exactement son role.

    private CustomerListResult? result;
    private bool isLoading;

    /// <summary>
    /// Page and search live in the query string: the screen stays linkable and back-navigable.
    /// (The property cannot be named <c>Page</c> — that is this component's own type name.)
    /// </summary>
    [SupplyParameterFromQuery(Name = "page")]
    public int? PageNumber { get; set; }

    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    private CustomerList.CustomerListView? LoadedPage
        => result?.Outcome == CustomerListOutcome.Loaded ? result.Page : null;

    private bool HasPage => !isLoading && LoadedPage is { IsEmpty: false };

    private int CurrentPage => LoadedPage?.Page ?? PageNumber ?? 1;

    private bool CanGoPrevious => HasPage && LoadedPage!.HasPrevious;

    private bool CanGoNext => HasPage && LoadedPage!.HasNext;

    private string CountLabel => LoadedPage is { IsEmpty: false } page
        ? $"{page.FirstItemIndex}–{page.LastItemIndex} sur {page.TotalItems} · page {page.Page} / {page.TotalPages}"
        : string.Empty;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        result = null;

        try
        {
            var loaded = await CustomerFacade.GetCustomersAsync(PageNumber ?? 1, PageSize, Search);

            result = loaded;
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>Construit l'URL canonique de la liste : pas de `page=1` ni de recherche vide.</summary>
    private string PageUrl(int page)
    {
        var query = new List<string>();

        if (page > 1)
        {
            query.Add($"page={page}");
        }

        if (!string.IsNullOrWhiteSpace(Search))
        {
            query.Add($"search={Uri.EscapeDataString(Search.Trim())}");
        }

        return query.Count == 0 ? "/customers" : $"/customers?{string.Join('&', query)}";
    }
}
