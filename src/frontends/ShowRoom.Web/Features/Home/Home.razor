<div class="rule"></div>

<!-- ================================================================ -->
<!-- Manifeste                                                         -->
<!-- ================================================================ -->
<section class="manifeste" aria-labelledby="manifeste-title">
    <div class="manifeste__label">
        <p class="section-label">Manifeste</p>
    </div>
    <div class="manifeste__body">
        <h2 class="manifeste__title" id="manifeste-title">
            Un module ne devient un service
            que le jour où c'est un choix.
        </h2>
        <p class="manifeste__text">
            ShowRoom part d'un modulith : des bounded contexts isolés dans un
            même processus, avec des frontières explicites et aucun couplage
            caché. Extraire un module dans son propre service devient alors
            une décision de déploiement, pas une réécriture.
        </p>
        <p class="manifeste__text">
            Les modules ne se parlent jamais par la base ni par HTTP interne :
            uniquement par contrats de messages sur le bus. Ce qui est livré
            est versionné, testé et observable de bout en bout.
        </p>
    </div>
</section>

<div class="rule"></div>

<!-- ================================================================ -->
<!-- Principes — les 3 piliers                                        -->
<!-- ================================================================ -->
<section class="principes" id="principes" aria-labelledby="principes-title">
    <div class="principes__header">
        <p class="section-label">Principes</p>
        <h2 class="principes__title" id="principes-title">Trois piliers.<br />Une seule trace.</h2>
    </div>

    <ol class="pillars" role="list">
        <li class="pillar pillar--active">
            <span class="pillar__number" aria-hidden="true">01</span>
            <div class="pillar__content">
                <h3 class="pillar__name">Frontières</h3>
                <p class="pillar__desc">
                    Chaque bounded context est un module vertical : Domain pur,
                    Persistence dédiée, Features en slices. Les dépendances sont
                    tenues par des tests d'architecture, pas par la discipline.
                </p>
                <ul class="pillar__items" aria-label="Éléments Frontières">
                    <li>Modulith + Vertical Slice</li>
                    <li>StronglyTypedId & PublicId</li>
                    <li>Contrats *.Contracts isolés</li>
                    <li>Architecture tests (ArchUnitNET)</li>
                </ul>
            </div>
            <div class="pillar__status pillar__status--live" aria-label="En place">
                <span class="status-dot"></span>En place
            </div>
        </li>

        <li class="pillar pillar--active">
            <span class="pillar__number" aria-hidden="true">02</span>
            <div class="pillar__content">
                <h3 class="pillar__name">Messaging</h3>
                <p class="pillar__desc">
                    Toute communication machine-à-machine passe par RabbitMQ via
                    Wolverine : request/reply pour lire, outbox transactionnel
                    pour publier — jamais un appel HTTP entre services.
                </p>
                <ul class="pillar__items" aria-label="Éléments Messaging">
                    <li>Request/reply AMQP</li>
                    <li>Outbox transactionnel</li>
                    <li>Inbox durable & dead-letter</li>
                    <li>Dégradation gracieuse</li>
                </ul>
            </div>
            <div class="pillar__status pillar__status--live" aria-label="En place">
                <span class="status-dot"></span>En place
            </div>
        </li>

        <li class="pillar">
            <span class="pillar__number" aria-hidden="true">03</span>
            <div class="pillar__content">
                <h3 class="pillar__name">Observabilité</h3>
                <p class="pillar__desc">
                    Le contexte de trace traverse le broker : le span du
                    consommateur rejoint celui du producteur. Logs structurés,
                    métriques métier et santé exposés par défaut.
                </p>
                <ul class="pillar__items" aria-label="Éléments Observabilité">
                    <li>Traces distribuées OTel</li>
                    <li>BeginModuleScope</li>
                    <li>Métriques messaging</li>
                    <li>Health & readiness</li>
                </ul>
            </div>
            <div class="pillar__status pillar__status--wip" aria-label="En cours">
                <span class="status-dot"></span>En cours
            </div>
        </li>
    </ol>
</section>

<div class="rule"></div>

<!-- ================================================================ -->
<!-- Modules                                                           -->
<!-- ================================================================ -->
<section class="module-focus" id="modules" aria-labelledby="modules-title">
    <div class="module-focus__meta">
        <p class="section-label">Modules actifs</p>
        <span class="module-tag">Customer</span>
        <span class="module-tag">Order</span>
        <span class="module-tag">Product</span>
    </div>

    <div class="module-focus__body">
        <h2 class="module-focus__title" id="modules-title">
            Trois contextes.<br />Deux services.
        </h2>
        <p class="module-focus__desc">
            Un client consulte son profil, l'historique de ses commandes et le
            détail d'un produit. Customer vit dans son propre service et
            interroge Order sur le bus ; Order et Product cohabitent dans le
            service Business. Aucun n'accède aux données de l'autre.
        </p>

        <dl class="module-specs">
            <div class="module-spec">
                <dt>Endpoint</dt>
                <dd><code>GET /api/v1/customers/{publicId}</code></dd>
            </div>
            <div class="module-spec">
                <dt>Identifiants</dt>
                <dd>PublicId exposé — identifiant technique interne</dd>
            </div>
            <div class="module-spec">
                <dt>Inter-modules</dt>
                <dd>Request/reply Wolverine sur <code>RabbitMQ</code></dd>
            </div>
            <div class="module-spec">
                <dt>Persistance</dt>
                <dd>Un schéma PostgreSQL par module</dd>
            </div>
            <div class="module-spec">
                <dt>Observabilité</dt>
                <dd>Traces structurées par <code>BeginModuleScope</code></dd>
            </div>
            <div class="module-spec">
                <dt>Tests</dt>
                <dd>Endpoints · Domain · Architecture</dd>
            </div>
        </dl>
    </div>
</section>

<div class="rule"></div>
