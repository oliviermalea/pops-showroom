    <PackageVersion Include="Microsoft.FeatureManagement" Version="4.6.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <!-- Must stay in [2.7.5, 3.0.0): Microsoft.AspNetCore.OpenApi 10.0.x's XML-comment source generator
         targets Microsoft.OpenApi 2.x; 3.x made IOpenApiMediaType.Example read-only and breaks codegen. -->
